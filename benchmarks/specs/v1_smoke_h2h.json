{
  "session": "v1_smoke_h2h",
  "expect_tag": "{tag}",
  "cycles": 1,
  "cells": [
    {
      "name": "h2h_smoke",
      "argv": [
        ".venv23/bin/python",
        "benchmarks/openspiel/eval_h2h_chess.py",
        "{rf_ckpt}",
        "{os_path}",
        "--os-checkpoint",
        "{os_ckpt}",
        "--games",
        "2",
        "--workers",
        "2",
        "--seed",
        "990000",
        "--device",
        "cuda",
        "--az-device",
        "/cuda:0",
        "--pgn",
        "{run_dir}/games.pgn",
        "--manifest",
        "{run_dir}/h2h_manifest.jsonl"
      ],
      "deadline_seconds": 3600,
      "cores": "0-3",
      "outputs": [
        "h2h_manifest.jsonl"
      ]
    }
  ]
}
