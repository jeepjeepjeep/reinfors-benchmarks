{
  "session": "v1_h2h",
  "expect_tag": "{tag}",
  "cycles": 3,
  "cells": [
    {
      "name": "h2h_100",
      "argv": [
        "benchmarks/h2h/eval_h2h.py"
      ],
      "args": {
        "rf-checkpoint": "{rf_ckpt_{cycle}}",
        "os-path": "{os_path_{cycle}}",
        "os-checkpoint": "{os_ckpt_{cycle}}",
        "games": 100,
        "workers": 4,
        "seed": "{cycle}000",
        "device": "cuda",
        "az-device": "/cuda:0",
        "out": "{run_dir}/h2h"
      },
      "deadline_seconds": 21600,
      "outputs": [
        "h2h/games.pgn"
      ]
    }
  ]
}
