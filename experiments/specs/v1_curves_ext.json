    },
    {
      "name": "kernel_rate_vs_batch_compiled",
      "argv": [
        "experiments/measure_inference.py"
      ],
      "args": {
        "game": "chess",
        "devices": "cuda",
        "depths": "8",
        "widths": "256",
        "batches": "512,1024,2048",
