      },
      "cores": "0-3",
      "deadline_seconds": 900,
      "outputs": [
        "inference/rows.jsonl"
      ]
    },
    {
      "name": "engine_rate_vs_n_games",
      "argv": [
        "experiments/measure_inference.py"
      ],
      "args": {
        "game": "chess",
        "devices": "cpu,cuda",
        "depths": "8",
